{
  "datasets": [
    {
      "name": "2d982da9",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `main`;\n",
        "USE SCHEMA `christma_hits_schema`;\n",
        "\n",
        "SELECT \n",
        "    artist,\n",
        "    COUNT(*) AS artist_count,\n",
        "    ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 2) AS percentage\n",
        "FROM main.christma_hits_schema.christmas_hits\n",
        "GROUP BY artist\n",
        "ORDER BY percentage DESC;"
      ]
    },
    {
      "name": "663b0535",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT  week_of_year,\n",
        "        SUM(streams) AS weekly_streams\n",
        "FROM main.christma_hits_schema.christmas_hits\n",
        "GROUP BY week_of_year;"
      ]
    },
    {
      "name": "2c399d2b",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "SELECT COUNT(streams),\n",
        "      date\n",
        "FROM main.christma_hits_schema.christmas_hits\n",
        "GROUP BY date;"
      ]
    }
  ],
